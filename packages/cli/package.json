{
  "name": "@motion-probe/cli",
  "version": "0.1.4",
  "description": "CLI and local daemon for motion-probe: arm recordings, trigger interactions, get JSON/text/OTLP reports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "motion-probe": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@motion-probe/core": "0.1.4",
    "ws": "^8.21.3"
  },
  "keywords": ["react-native", "animation", "motion", "testing", "cli", "agent"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraftsManShip001/motion-probe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/CraftsManShip001/motion-probe#readme",
  "bugs": "https://github.com/CraftsManShip001/motion-probe/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
