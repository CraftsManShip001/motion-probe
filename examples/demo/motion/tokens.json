{
  "$description": "Motion tokens in W3C Design Tokens (DTCG) format, as exported from a design system.",
  "motion": {
    "duration": {
      "$type": "duration",
      "short": { "$value": "200ms" },
      "medium": { "$value": "250ms" },
      "long": { "$value": { "value": 300, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear": { "$value": [0, 0, 1, 1] },
      "decelerate": { "$value": [0.215, 0.61, 0.355, 1] },
      "decelerate-soft": { "$value": [0.25, 0.46, 0.45, 0.94] }
    },
    "transition": {
      "$type": "transition",
      "enter": { "$value": { "duration": "{motion.duration.long}", "delay": "0ms", "timingFunction": "{motion.easing.decelerate}" } },
      "toast": { "$value": { "duration": "{motion.duration.medium}", "delay": "0ms", "timingFunction": "{motion.easing.decelerate-soft}" } }
    },
    "spring": {
      "$type": "spring",
      "playful": { "$value": { "damping": 6, "stiffness": 120, "mass": 1 } }
    }
  }
}
